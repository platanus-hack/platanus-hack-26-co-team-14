# ============================================================
#  TEMIS — copiar a .env y rellenar
#
#      cp .env.example .env
#
#  Obligatorias: las 5 primeras. El resto tiene valor por defecto.
# ============================================================


# ─────────────────────────────────────────────
#  1. KAPSO  (WhatsApp)
# ─────────────────────────────────────────────
# Panel de Kapso → API Keys
KAPSO_API_KEY=

# Panel de Kapso → WhatsApp → el número largo del phone number
KAPSO_PHONE_NUMBER_ID=


# ─────────────────────────────────────────────
#  2. ELEVENLABS  (voz)
# ─────────────────────────────────────────────
# elevenlabs.io → Profile → API Keys
# Al crearla marcar: Text to Speech + Speech to Text
ELEVENLABS_API_KEY=

# La voz con la que responde el bot.
# Para ver las disponibles:  python -m puente.probar --voces
ELEVENLABS_VOICE_ID=


# ─────────────────────────────────────────────
#  3. CLAUDE  (extracción de datos)
# ─────────────────────────────────────────────
# console.anthropic.com → API Keys
# Es lo que usa extraccion.py para sacar los slots de lo que dijo la usuaria.
# Sin esta llave el canal recibe el audio pero no entiende nada.
ANTHROPIC_API_KEY=

# Revisión final obligatoria antes de enviar una tutela. Con "auto" se activa
# cuando ANTHROPIC_API_KEY está configurada. En producción déjelo en auto o 1.
REVISION_JURIDICA_IA=auto
MODELO_REVISION_JURIDICA=claude-sonnet-4-5-20250929


# ─────────────────────────────────────────────
#  4. BACKEND  (normalmente NO se toca)
# ─────────────────────────────────────────────
# El cerebro de este repo (canal/ + core/ + juridico/) corre en el mismo
# proceso que el puente. DEJAR VACÍO: así se usa, sin salto HTTP.
#
# Solo se rellena para apuntar el puente a OTRO backend, que entonces tiene
# que implementar POST {BACKEND_URL}/mensaje (contrato en puente/README.md).
BACKEND_URL=

# Se manda como  Authorization: Bearer <token>  al backend. Opcional.
BACKEND_TOKEN=


# ─────────────────────────────────────────────
#  5. TOKEN DEL PUENTE
# ─────────────────────────────────────────────
# El backend lo usa para llamar a /api/enviar, /api/voz, etc.
# Genera uno cualquiera:  python -c "import secrets;print(secrets.token_urlsafe(24))"
# OBLIGATORIO en producción. En local, si se deja vacío se genera al vuelo.
API_TOKEN=


# ─────────────────────────────────────────────
#  6. URL PÚBLICA
# ─────────────────────────────────────────────
# EN LOCAL   : la del túnel.  `python arrancar.py` la escribe sola.
# EN VERCEL  : dejar VACÍA (se detecta con VERCEL_URL).
# EN RENDER  : dejar VACÍA (se detecta con RENDER_EXTERNAL_URL).
PUBLIC_BASE_URL=


# ─────────────────────────────────────────────
#  7. WEBHOOK  (opcional)
# ─────────────────────────────────────────────
WEBHOOK_PATH=/webhooks/whatsapp

# Kapso → Add Webhook Endpoint → Advanced settings → signing secret.
# Si lo tienes, pégalo y pon VERIFICAR_FIRMA=1.
KAPSO_WEBHOOK_SECRET=
VERIFICAR_FIRMA=0


# ============================================================
#  De aquí abajo no hace falta tocar nada.
# ============================================================

PORT=8000

# "http"       = responde y se auto-invoca (obligatorio en Vercel)
# "background" = responde y encola en el mismo proceso (Render / local)
# Si se deja vacío se detecta solo.
MODO_PROCESO=

UMBRAL_CONFIANZA_STT=0.75

KAPSO_API_BASE=https://api.kapso.ai
KAPSO_VERSION=v24.0

ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_STT_LANGUAGE=spa
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Cómo suena la voz. Estabilidad alta = más pausada y predecible,
# que es lo que conviene para leerle datos a alguien mayor.
TTS_ESTABILIDAD=0.6
TTS_SIMILITUD=0.8
TTS_VELOCIDAD=0.9

BACKEND_TIMEOUT=30

# La conversación y sus datos se eliminan tras 10 minutos sin mensajes.
SESION_TTL_SEGUNDOS=600

# Teléfonos diferentes se procesan en paralelo; cada chat conserva su orden.
PROCESADORES_CONCURRENTES=4
COLA_MAX_MENSAJES=200
