{
  // Your project's name, as it will appear on the voting page.
  "project-name": "TEMIS",

  // Short one-line summary of your project (in Spanish).
  "project-oneliner-spanish": "Asistente de voz que ayuda a personas a redactar y radicar tutelas, desacatos y PQRD en salud, con información jurídica verificable.",

  // Brief description of your project (in Spanish).
  "project-description-spanish": "TEMIS es un canal conversacional por voz (WhatsApp vía Kapso) que guía a usuarios sin conocimientos legales a través del proceso de solicitar una acción de tutela, un desacato o una PQRD relacionada con salud (EPS, PBS). El usuario habla, el sistema transcribe y extrae la información relevante (cédula, EPS, municipio, hechos), y un triage determinístico decide la ruta jurídica correspondiente. A partir de la información recopilada, la IA participa en la estructuración y redacción del contenido jurídico, utilizando como base plantillas, reglas y fuentes jurídicas verificadas, para generar el documento final en PDF. Además, TEMIS incorpora un sistema de monitoría y seguimiento del caso: registra la fecha de radicación, calcula los términos aplicables en días hábiles y realiza seguimientos periódicos con el usuario para verificar si recibió respuesta. Cada tres días se consulta el estado del trámite y, una vez vencido el término legal correspondiente, se activa un seguimiento específico para determinar, según la respuesta del usuario, cuál debe ser el siguiente paso del proceso.",

  // Public URL where your project is deployed and running.
  "deploy-url": "https://platanus-hack-26-co-team-14.onrender.com"
}
